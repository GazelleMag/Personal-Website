{
  "hosting": {
    "public": "dist/Personal-Website",
    "headers": [
      {
        "source": "/assets/CV.pdf",
        "headers": [
          {
            "key": "Content-Disposition",
            "value": "attachment; filename=CV.pdf"
          },
          {
            "key": "Content-Type",
            "value": "application/pdf"
          }
        ]
      }
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
